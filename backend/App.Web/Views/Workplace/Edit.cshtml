@model App.Domain.Entities.WorkplaceEntity

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>WorkplaceEntity</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Identifier" class="control-label">Identifier</label>
                <input asp-for="Identifier" class="form-control" placeholder="format: XXXX-XXXX"/>
                <span asp-validation-for="Identifier" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClassroomId" class="control-label">Classroom</label>
                <select asp-for="ClassroomId" class="form-control" asp-items="ViewBag.Classroom"></select>
            </div>
            <div class="form-group">
                <label asp-for="ComputerCode" class="control-label">Computer Code</label>
                <input asp-for="ComputerCode" class="form-control" />
                <span asp-validation-for="ComputerCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Deleted" class="control-label">Soft Deleted</label>
                <input asp-for="Deleted" class="form-check-input" type="checkbox" />
                <span asp-validation-for="Deleted" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedByClient" />
            <input type="hidden" asp-for="UpdatedBy" />
            <input type="hidden" asp-for="UpdatedByClient" />
            <input type="hidden" asp-for="UpdatedAt" />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
