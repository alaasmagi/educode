@model dynamic

@{
    var pageIndex = (int)ViewData["PageIndex"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var hasPreviousPage = (bool)ViewData["HasPreviousPage"]!;
    var hasNextPage = (bool)ViewData["HasNextPage"]!;
    var pageSize = (int)ViewData["PageSize"]!;
    var totalCount = (int)ViewData["TotalCount"]!;
}

<div class="pagination-container" style="margin-top: 20px;">
    <div class="pagination-info" style="margin-bottom: 10px;">
        <p>Showing page @pageIndex of @totalPages (Total items: @totalCount)</p>
    </div>
    
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(!hasPreviousPage ? "disabled" : "")">
                <a class="page-link" 
                   href="@(hasPreviousPage ? Url.Action("Index", new { pageNumber = 1, pageSize = pageSize }) : "#")" 
                   aria-label="First">
                    <span aria-hidden="true">&laquo;&laquo;</span>
                </a>
            </li>
            <li class="page-item @(!hasPreviousPage ? "disabled" : "")">
                <a class="page-link" 
                   href="@(hasPreviousPage ? Url.Action("Index", new { pageNumber = pageIndex - 1, pageSize = pageSize }) : "#")" 
                   aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            @{
                var startPage = Math.Max(1, pageIndex - 2);
                var endPage = Math.Min(totalPages, pageIndex + 2);
                
                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = 1, pageSize = pageSize })">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == pageIndex ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, pageSize = pageSize })">@i</a>
                    </li>
                }

                if (endPage < totalPages)
                {
                    if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { pageNumber = totalPages, pageSize = pageSize })">@totalPages</a>
                    </li>
                }
            }

            <li class="page-item @(!hasNextPage ? "disabled" : "")">
                <a class="page-link" 
                   href="@(hasNextPage ? Url.Action("Index", new { pageNumber = pageIndex + 1, pageSize = pageSize }) : "#")" 
                   aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
            <li class="page-item @(!hasNextPage ? "disabled" : "")">
                <a class="page-link" 
                   href="@(hasNextPage ? Url.Action("Index", new { pageNumber = totalPages, pageSize = pageSize }) : "#")" 
                   aria-label="Last">
                    <span aria-hidden="true">&raquo;&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="page-size-selector" style="margin-top: 10px;">
        <form method="get" style="display: inline-block;">
            <label for="pageSize">Items per page:</label>
            <select name="pageSize" id="pageSize" onchange="this.form.submit()" class="form-select" style="width: auto; display: inline-block;">
                <option value="5" selected="@(pageSize == 5)">5</option>
                <option value="10" selected="@(pageSize == 10)">10</option>
                <option value="25" selected="@(pageSize == 25)">25</option>
                <option value="50" selected="@(pageSize == 50)">50</option>
                <option value="100" selected="@(pageSize == 100)">100</option>
            </select>
            <input type="hidden" name="pageNumber" value="1" />
        </form>
    </div>
</div>

